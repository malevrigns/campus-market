# Production compose: domain must resolve to this server, ports 80/443 reachable.
DOMAIN=campus.example.com
GOPROXY=https://proxy.golang.org,direct

# Leave all Alipay fields empty to disable payment. No mock payment fallback.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# Container paths; host files go in ./secrets, readable by UID 10001.
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=

# Chat Completions-compatible streaming model endpoint, for example https://provider.example/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Server-authorized administrators; comma-separated existing user IDs, never emails.
ADMIN_USER_IDS=
# Optional trusted provider/MCP connections file inside the secrets mount.
# See deploy/agent-connections.example.json; custom credential env vars are read only by the API.
AGENT_CONNECTIONS_FILE=

# Verification delivery: disabled | live. local is development-only.
AUTH_DELIVERY_MODE=disabled
# Required with live delivery in production, at least 32 random bytes.
AUTH_CODE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Aliyun China SMS: approved sign and template containing ${code}.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_REGION=cn-hangzhou
